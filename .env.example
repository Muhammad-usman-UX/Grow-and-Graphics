# ---- Supabase (required) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only. Never prefix with NEXT_PUBLIC_

# ---- Admin ----
ADMIN_EMAIL=                    # the one admin user created in Supabase Auth

# ---- AI (add later; the site works without them) ----
IMAGE_PROVIDER=mock             # mock | gemini | openai
IMAGE_API_KEY=
TEXT_API_KEY=                   # used for the UI/UX audit text (Gemini key works)

# ---- Email (paused until set) ----
RESEND_API_KEY=
EMAIL_FROM=                     # e.g. "Grow and Graphics <hello@yourdomain.com>"

# ---- Public site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://g.page/r/CezGoiZtjb_sEAI/review
NEXT_PUBLIC_GOOGLE_PROFILE_URL=

# ---- Text AI for the UI/UX audit ----
TEXT_PROVIDER=mock              # mock | gemini | openai  (mock = rule-based checks only, free)

# ---- Optional model overrides ----
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEXT_MODEL=gpt-4o-mini
IMAGE_QUALITY=medium

# ---- Daily follow-up email job (Vercel sends this as a Bearer token) ----
CRON_SECRET=
